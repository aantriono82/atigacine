{
  "name": "atiga-cine",
  "version": "0.1.3",
  "description": "A lightweight native video player for Linux",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "test:unit": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "verify": "pnpm lint && pnpm lint:rust && pnpm test:unit && pnpm check && pnpm build",
    "tauri:dev": "LD_LIBRARY_PATH=./src-tauri/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH} tauri dev",
    "tauri:build": "APPIMAGE_EXTRACT_AND_RUN=1 tauri build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "tauri-plugin-libmpv-api": "^0.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.16"
  }
}
